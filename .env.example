# ── Database ──────────────────────────────────────────────────────────────────
# Supabase connection string (Session mode, port 5432 or Transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Authentication ─────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Login credentials (single-user app)
AUTH_USERNAME=admin
# bcrypt hash of your password. Generate with:
#   node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
AUTH_PASSWORD_HASH=$2b$12$replace-with-real-bcrypt-hash

# ── External APIs ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GOOGLE_MAPS_API_KEY=AIza...
