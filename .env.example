# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://full_crm_demo:full_crm_demo@localhost:5432/full_crm_demo

# Full CRM Demo safety defaults
# Keep this false to block accidental use of Supabase or other remote DBs.
ALLOW_REMOTE_DB=false
# Optional: set to "disable" for local DB or "require" for remote DB.
# If omitted, the app auto selects based on DATABASE_URL host.
DB_SSL_MODE=disable

# ── Authentication ─────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Login credentials (single-user app)
AUTH_USERNAME=admin
# bcrypt hash of your password. Generate with:
#   node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
AUTH_PASSWORD_HASH=$2b$12$replace-with-real-bcrypt-hash

# ── External APIs ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GOOGLE_MAPS_API_KEY=AIza...
